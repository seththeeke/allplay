#!/bin/sh
# Lints only the packages with staged changes, plus the repo-wide emoji check.
set -e
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0
node scripts/check-docs.mjs
for package in backend web-app cdk; do
  if printf '%s\n' "$staged" | grep -q "^$package/"; then
    if [ -d "$package/node_modules" ]; then
      echo "pre-commit: linting $package"
      npm run --silent lint --prefix "$package"
    else
      echo "pre-commit: $package has no node_modules; run npm ci --prefix $package"
      exit 1
    fi
  fi
done
