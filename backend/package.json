{
  "name": "@allplay/backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:local": "tsx src/local/integrationRun.ts",
    "eval:build": "tsx tests/decision-eval/buildCases.ts",
    "eval:decider": "tsx tests/decision-eval/evalDecider.ts",
    "test:simulation": "vitest run --config vitest.simulation.config.ts",
    "build:cli": "esbuild src/cli/bin.ts --bundle --platform=node --format=esm --target=node22 --outfile=cli/dist/game-engine-cli.mjs --banner:js='#!/usr/bin/env node'",
    "setup:speech:macos": "sh src/local/macos-speech/build.sh",
    "setup:speech:whisper": "brew install whisper-cpp && mkdir -p .local/models && curl -L --fail -o .local/models/ggml-base.en.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin",
    "dev:server": "tsx src/local/start.ts",
    "setup:speech:kokoro": "sh src/local/kokoro/setup.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@aws-sdk/client-bedrock-runtime": "3.1163.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1163.0",
    "@aws-sdk/client-codepipeline": "3.1163.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1163.0",
    "@aws-sdk/client-dynamodb": "3.1163.0",
    "@aws-sdk/client-iam": "3.1163.0",
    "@aws-sdk/client-polly": "3.1163.0",
    "@aws-sdk/client-secrets-manager": "3.1163.0",
    "@aws-sdk/client-transcribe-streaming": "3.1163.0",
    "@aws-sdk/lib-dynamodb": "3.1163.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity": "3.1163.0",
    "@aws-sdk/client-sts": "3.1163.0",
    "@eslint/js": "9.39.5",
    "@smithy/hash-node": "4.5.2",
    "@smithy/signature-v4": "5.7.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "aws-amplify": "6.22.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
