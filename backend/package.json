{
  "name": "@allplay/backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:simulation": "vitest run --config vitest.simulation.config.ts",
    "build:cli": "esbuild src/cli/bin.ts --bundle --platform=node --format=esm --target=node22 --outfile=cli/dist/game-engine-cli.mjs --banner:js='#!/usr/bin/env node'"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
