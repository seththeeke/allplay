{
  "name": "@allplay/cdk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "synth": "cdk synth --quiet --profile allplays",
    "diff": "cdk diff --profile allplays",
    "deploy": "cdk deploy --profile allplays"
  },
  "dependencies": {
    "aws-cdk-lib": "2.277.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "aws-cdk": "2.1148.1",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
